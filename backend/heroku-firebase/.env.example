# Firebase backend — required environment variables
# Copy this file to .env and fill in the values
# At least one of FIREBASE_ADMIN_KEY_PATH or FIREBASE_SERVICE_ACCOUNT_JSON must be set

# Option 1: Path to Firebase service account JSON file
FIREBASE_ADMIN_KEY_PATH=/etc/secrets/firebaseAdminKey.json

# Option 2: Inline Firebase service account JSON (mutually exclusive with key path)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Runtime environment
NODE_ENV=development
